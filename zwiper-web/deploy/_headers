# Response headers for app.zwipe.net, read by Cloudflare Pages.
#
# The Content-Security-Policy runs as Report-Only: the browser logs what the
# policy would block to the console and blocks nothing. Once a click-through
# shows no violations, the header is renamed to Content-Security-Policy.
# The script-src hash is index.html's first-paint script; the test
# `first_paint_matches_the_themes` in src/lib/outbound/theme_store.rs fails
# when the script changes and the hash here does not.
#
# Every response revalidates (no-cache), so a refresh always loads the
# newest index.html and the bundle it names. The bundle is not marked
# immutable: Pages applies these rules to 404s too, and an asset fetched in
# the gap before it reached the edge would stay a cached 404 for a year. The
# version file the app reads to find a newer build is never stored at all.
/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'sha256-vzS7wNFdrljc6gGQ+wsLewMU+/I5mAQWZPnUWqanIbo='; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; img-src 'self' data: blob: https://cards.scryfall.io https://svgs.scryfall.io; connect-src 'self' https://api.zwipe.net; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/version.json
  ! Cache-Control
  Cache-Control: no-store
