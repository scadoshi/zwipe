[Unit]
Description=Zwipe nightly sync (Scryfall, otags, rollups)
Wants=network-online.target
After=network-online.target postgresql.service
OnFailure=zervice-alert.service

[Service]
Type=oneshot
User=scadoshi
WorkingDirectory=/home/scadoshi/zwipe
EnvironmentFile=/home/scadoshi/zwipe/.env.zervice
ExecStart=/home/scadoshi/zwipe/zervice
